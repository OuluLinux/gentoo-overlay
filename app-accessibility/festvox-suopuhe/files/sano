#!/bin/sh
# Convert UTF-8 arguments to ISO-8859-1 for Festival and speak them.
set -euo pipefail

FESTIVALDIR="${FESTIVALDIR:-/usr/share/festival}"
export FESTIVALDIR
FESTVOX_SUOPUHE_HOME="/etc/festvox-suopuhe"
_FESTVOX_USER_HOME="${FESTVOX_SUOPUHE_USER_HOME:-${HOME:-}}"
export FESTVOX_SUOPUHE_USER_HOME="$_FESTVOX_USER_HOME"

tmpfile=$(mktemp /tmp/sano-XXXXXX)
trap 'rm -f "$tmpfile"' EXIT

for arg in "$@"; do
  printf '%s ' "$arg"
done > "$tmpfile"

iconv -f UTF-8 -t ISO-8859-1 "$tmpfile" | HOME="${FESTVOX_SUOPUHE_HOME}" festival --tts >/dev/null 2>&1
