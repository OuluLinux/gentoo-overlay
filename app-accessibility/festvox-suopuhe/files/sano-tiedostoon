#!/bin/sh
# Convert UTF-8 arguments into a WAV file using Festival.
set -euo pipefail

if [ $# -lt 2 ]; then
  echo "Usage: $0 output-wave-file text..." >&2
  exit 1
fi

outfile=$1
shift

FESTIVALDIR="${FESTIVALDIR:-/usr/share/festival}"
export FESTIVALDIR
FESTVOX_SUOPUHE_HOME="/etc/festvox-suopuhe"
_FESTVOX_USER_HOME="${FESTVOX_SUOPUHE_USER_HOME:-${HOME:-}}"
export FESTVOX_SUOPUHE_USER_HOME="$_FESTVOX_USER_HOME"

tmpfile=$(mktemp /tmp/sano-tiedostoon-XXXXXX)
encoded=$(mktemp /tmp/sano-tiedostoon-encoded-XXXXXX)
trap 'rm -f "$tmpfile" "$encoded"' EXIT

printf '%s ' "$@" > "$tmpfile"
iconv -f UTF-8 -t ISO-8859-1 "$tmpfile" > "$encoded"
	TEXT_TO_WAVE_SCRIPT="/usr/share/festvox-suopuhe/suopuhe-tts-to-wave.scm"
	HOME="${FESTVOX_SUOPUHE_HOME}" \
	FESTVOX_SUOPUHE_USER_HOME="$_FESTVOX_USER_HOME" \
	FESTIVALDIR="${FESTIVALDIR}" \
	SUOPUHE_TEXT_FILE="$encoded" \
	SUOPUHE_WAVE_FILE="$outfile" \
	festival --libdir /usr/share/festival/lib --script "$TEXT_TO_WAVE_SCRIPT"
